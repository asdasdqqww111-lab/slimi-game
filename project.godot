; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SLIMI"
config/description="لعبة سلايم ثلاثية الأبعاد لطيفة وذكية للأندرويد — SLIMI 3D Companion"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

LocalizationManager="*res://scripts/core/localization_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
QualityManager="*res://scripts/core/quality_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
AndroidPlatformManager="*res://scripts/core/android_platform_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/android/enable_long_press_as_right_click=false
pointing/android/enable_pan_and_scale_gestures=false
pointing/emulate_touch_from_mouse=true

[internationalization]

rendering/text_driver="ICU / HarfBuzz / Graphite (Built-in)"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"
3d/default_gravity=13.5

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.96, 0.89, 0.97, 1)
